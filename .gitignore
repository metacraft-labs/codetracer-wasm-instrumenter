target/
node_modules/
# The dev shell links `node_modules` in as a symlink, which the
# directory-only pattern above does not match.
node_modules
*.log
*.tmp
.DS_Store
# nix-direnv's per-repo state.
.direnv/
# `nix build` / `just nix-build` output link.
/result
/result-*
# Generated by git-hooks.nix when the dev shell is entered; the hook set is
# declared in flake.nix, so the rendered config is a build artefact.
.pre-commit-config.yaml

# Repro development environment cache
.repro/
